### Strings for the Solitaire widget, a card game. The start card leads to a
### larger playing view. It's shown in an iframe on the Firefox New Tab
### page, about 332 pixels wide, so keep strings short.

# Klondike is the name of the most common solitaire game.
solitaire-start-intro = Classic Klondike. Clear the board.
# Shown instead of solitaire-start-intro when a saved game exists.
solitaire-start-in-progress = You have a game in progress.
solitaire-start-play-button = Play
# Shown instead of solitaire-start-play-button when a saved game exists.
solitaire-start-resume-button = Resume game
# Debug button that clears the saved game.
solitaire-playing-reset-button = Reset
# Closes the playing view and returns to the start card.
solitaire-playing-close-button = Close
